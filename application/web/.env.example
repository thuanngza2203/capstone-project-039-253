# Chép thành .env.local (chạy dev) hoặc .env.production (build để deploy). Không commit file .env thật.

# --- Chỉ dùng khi chạy local (npm run dev / npm run preview): proxy của Vite chuyển tiếp tới đâu.
# DETECTION_TARGET=http://127.0.0.1:8005
# RAG_TARGET=http://127.0.0.1:8010

# --- Khi deploy: web gọi thẳng địa chỉ public của từng API (bỏ trống = dùng proxy /detection, /rag).
# VITE_DETECTION_URL=https://api.example.com
# VITE_RAG_URL=https://rag.example.com
