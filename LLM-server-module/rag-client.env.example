# Ghép các dòng này vào RAG-module/.env trên HOST, giữ các cấu hình RAG khác.
# Client cho server Qwen/Qwen3.8-27B-FP8 trong .env.example.
# Ví dụ SSH tunnel: host 8001 -> Vast 8000; thay URL nếu dùng API public.
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:8001/v1
# Dùng URL đầy đủ ở trên: để trống HOST/PORT để tránh xung đột cấu hình cũ.
VLLM_HOST=
VLLM_PORT=
# Phải khớp LLM_SERVED_MODEL_NAME bên server.
# Đây là alias API, không phải tên checkpoint Hugging Face.
VLLM_MODEL=rag-llm
# Điền cùng LLM_API_KEY bên server; nếu đã cấu hình thì giữ key đang dùng.
VLLM_API_KEY=
VLLM_MAX_TOKENS=800
VLLM_TIMEOUT=120
# Để server quyết định thinking theo model; true/false sẽ ghi đè server.
VLLM_THINK=
