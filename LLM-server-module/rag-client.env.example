# Ghép các dòng này vào RAG-module/.env trên HOST, giữ các cấu hình RAG khác.
# Ví dụ SSH tunnel: host 8001 -> Vast 8000.
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:8001/v1
# Phải khớp LLM_SERVED_MODEL_NAME bên server.
VLLM_MODEL=qwen3.5-4b
# Phải khớp LLM_API_KEY bên server.
VLLM_API_KEY=
VLLM_MAX_TOKENS=800
VLLM_TIMEOUT=120
VLLM_THINK=false
