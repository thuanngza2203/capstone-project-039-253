# File này dành cho SERVER Vast: Qwen 27B FP8 trên 1 GPU 48 GiB.
# Copy thành .env khi cài mới; nếu đã có .env, sửa từng dòng để giữ API key.
# Không copy sang RAG-module. Giữ hậu tố -FP8 khi dùng cấu hình GPU này.
LLM_MODEL_ID=Qwen/Qwen3.8-27B-FP8
# Giữ tên API này khi đổi model; bên RAG đặt VLLM_MODEL=rag-llm.
# Nếu server cũ dùng alias khác, giữ alias đó và đặt client khớp nhau.
LLM_SERVED_MODEL_NAME=rag-llm
LLM_PORT=8000
# Bắt buộc: tự tạo key, rồi điền cùng giá trị vào VLLM_API_KEY bên RAG.
LLM_API_KEY=

# Tổng token đầu vào (câu hỏi + history + tài liệu) và đầu ra, cho mỗi request.
LLM_MAX_MODEL_LEN=8192
# Khởi đầu với một request đang xử lý; tăng sau khi đo tải thực tế.
LLM_MAX_NUM_SEQS=1
LLM_TENSOR_PARALLEL_SIZE=1
# GPU dành riêng cho LLM: 0.90 cho ngân sách khoảng 43.2 GiB trên GPU 48 GiB.
# Đây là tỷ lệ VRAM, không phải tỷ lệ sức tính toán; nvidia-smi có thể báo khác.
LLM_GPU_MEMORY_UTILIZATION=0.90
LLM_DTYPE=auto
# Qwen3.8 dùng parser qwen3; chỉ phục vụ văn bản cho RAG.
LLM_REASONING_PARSER=qwen3
LLM_LANGUAGE_MODEL_ONLY=true
# Server đặt thinking mặc định; RAG để VLLM_THINK= trống để dùng cấu hình này.
LLM_CHAT_TEMPLATE_KWARGS='{"enable_thinking": false}'
# Checkpoint đã là FP8: để trống để vLLM tự đọc quantization từ model.
LLM_QUANTIZATION=
# Nếu cần template riêng: đường tới file .jinja, tính từ LLM-server-module.
LLM_CHAT_TEMPLATE_FILE=
# Chỉ áp dụng câu hỏi kiểm tra của check_api.py, không giới hạn output của RAG.
LLM_CHECK_MAX_TOKENS=800
# Đường tương đối tính từ LLM-server-module, không phụ thuộc thư mục chạy lệnh.
LLM_CACHE_DIR=models/huggingface

# Có thể tăng khi mạng Hugging Face chậm; không sửa được DNS/mạng bị ngắt.
# HF_HUB_ETAG_TIMEOUT=60
# HF_HUB_DOWNLOAD_TIMEOUT=120

# serve.py nghe 127.0.0.1. Kết nối bằng SSH tunnel hoặc HTTPS proxy trong README.
