
# Chon ollama, gemini hoac vllm. Chay lai chuong trinh sau khi doi.
LLM_PROVIDER=ollama

# Chunking: recursive (1000 ky tu, overlap 150) | structure (heading + token).
# Sau khi doi strategy, chay index mot lan; sau do search/ask/chat dung index tuong ung.
CHUNKING_STRATEGY=structure
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40
# Trong = dung tokenizer cua EMBEDDING_MODEL. Chi tai tokenizer khi structure/preview.
CHUNK_TOKENIZER_MODEL=
# Trong = recursive -> chroma_db; structure -> chroma_db_structure.
# Neu dien duong dan rieng, index/search/ask/chat deu dung duong dan nay.
CHROMA_DIR=

# Tham so cua duong recursive va so chunk tra ve moi query.
# Khong khai bao = dung mac dinh 1000 / 150 / 4. Neu khai bao thi phai dien so.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# Retrieval doc lap voi LLM_PROVIDER. Chon semantic, bm25 hoac hybrid.
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
# Chi tai model khi bat reranker. CPU de danh GPU cho LLM.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_DEVICE=cpu

OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=800
# Thoi gian Ollama giu LLM sau request; vi du 30m, hoac -1m de khong tu het han.
# Embedding/reranker local duoc giu bang python main.py chat, khong theo bien nay.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false

# Lich su trong mot phien chat; 0 luot de tat. Khong luu xuong dia.
CHAT_HISTORY_TURNS=4
CHAT_HISTORY_MAX_CHARS=6000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# vLLM chay trong Docker, RAG chay tren Windows.
# Model phai khop id tra ve tu GET /v1/models.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_API_KEY=
VLLM_MAX_TOKENS=800
VLLM_TIMEOUT=120
# Qwen3: false de tat thinking. De trong neu model khong ho tro.
VLLM_THINK=false

EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
EMBEDDING_DEVICE=cuda
