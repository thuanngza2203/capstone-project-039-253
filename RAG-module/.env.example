
# Chon ollama, gemini hoac vllm. Chay lai chuong trinh sau khi doi.
LLM_PROVIDER=ollama

# Chunking: recursive (1000 ky tu, overlap 150) | structure (heading + token).
# Sau khi doi strategy, chay index mot lan; sau do search/ask/chat dung index tuong ung.
CHUNKING_STRATEGY=structure
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40
# Trong = dung tokenizer cua EMBEDDING_MODEL. Chi tai tokenizer khi structure/preview.
CHUNK_TOKENIZER_MODEL=
# Trong = recursive -> chroma_db; structure -> chroma_db_structure.
# Neu dien duong dan rieng, index/search/ask/chat deu dung duong dan nay.
CHROMA_DIR=

# Tham so cua duong recursive va so chunk tra ve moi query.
# Khong khai bao = dung mac dinh 1000 / 150 / 4. Neu khai bao thi phai dien so.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6

# Retrieval doc lap voi LLM_PROVIDER. Chon semantic, bm25 hoac hybrid.
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
# Chi tai model khi bat reranker. CPU de danh GPU cho LLM.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_DEVICE=cpu

OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=800
# Thoi gian Ollama giu LLM sau request; vi du 30m, hoac -1m de khong tu het han.
# Embedding/reranker local duoc giu bang python main.py chat, khong theo bien nay.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false

# Lich su trong mot phien chat; 0 luot de tat. Khong luu xuong dia.
CHAT_HISTORY_TURNS=4
CHAT_HISTORY_MAX_CHARS=6000

GEMINI_API_KEY=
# gemini-2.5-flash khong con mo cho tai khoan moi (25/09/2026). Web chon Gemini qua CHAT_LLM_PROVIDERS ben detection.
GEMINI_MODEL=gemini-3.5-flash

# vLLM local (Docker/Linux) hoac remote tren Vast.ai; RAG van chay o host nay.
# Huong dan server: ../LLM-server-module/README.md
# Neu playground da goi duoc: dung cung Base URL, Model va API key trong sidebar.
# LLM_PROVIDER=vllm moi chon client nay; cac gia tri duoi khong doi provider tu dong.
# Dia chi server: dien VLLM_HOST + VLLM_PORT, de trong VLLM_BASE_URL.
#   SSH tunnel (server Vast nghe 127.0.0.1): HOST=127.0.0.1, PORT=cong local cua tunnel.
#   HTTPS qua nginx: SCHEME=https, HOST=ten mien, PORT=cong public (de trong neu 443).
# VLLM_HOST chi la IP hoac ten mien, khong kem http:// va khong kem :cong.
VLLM_SCHEME=http
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
# Hoac dien URL day du o day va de trong HOST/PORT, vi du http://127.0.0.1:8001/v1
VLLM_BASE_URL=
# Model phai khop id tra ve tu GET /v1/models (LLM_SERVED_MODEL_NAME ben server).
# rag-llm la alias mac dinh cua LLM-server-module; server cu co the dung ten khac.
VLLM_MODEL=rag-llm
VLLM_API_KEY=
VLLM_MAX_TOKENS=800
VLLM_TIMEOUT=120
# Qwen3: false de tat thinking. De trong neu model khong ho tro.
VLLM_THINK=false

EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
EMBEDDING_DEVICE=cuda

# RAG API server: python -m server; Swagger tai http://127.0.0.1:8010/docs
# detection-server goi API bang header Authorization: Bearer <RAG_API_KEY>.
# De trong RAG_API_KEY thi tat xac thuc (API public). Nghe 0.0.0.0 khi khong co key van chay, chi in canh bao.
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8010
RAG_API_KEY=
# Origin duoc goi API tu trinh duyet, cach nhau dau phay; * = moi origin, de trong = tat CORS.
RAG_API_CORS_ORIGINS=*
