# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Biến đã đặt trong môi trường tiến trình được ưu tiên hơn file này.

# ---------------------------------------------------------------------------
# Groq: normalizer luôn dùng; answer model chỉ dùng khi ANSWER_BACKEND=groq
# ---------------------------------------------------------------------------
GROQ_API_KEY=
NORMALIZER_MODEL=openai/gpt-oss-120b
# Theo model: openai/gpt-oss-* nhận low | medium | high; qwen/qwen3-32b nhận none | default.
# Sai giá trị thì Groq trả 400 ở mọi lượt chat. Để trống = không gửi tham số.
NORMALIZER_REASONING_EFFORT=low
ANSWER_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Sinh câu trả lời
#   groq = rag/ nội bộ + Feedback RAG + Groq (như trước refactor)
#   rag  = gọi RAG-module server: POST {RAG_API_URL}/v1/answer
# Đổi backend chỉ cần đổi biến này, không sửa code.
# ---------------------------------------------------------------------------
ANSWER_BACKEND=groq
RAG_API_URL=http://127.0.0.1:8010
# Khớp RAG_API_KEY trong RAG-module/.env; để trống khi RAG tắt xác thực (API public).
RAG_API_KEY=
# Giây; phải lớn hơn timeout LLM bên RAG (VLLM_TIMEOUT=120).
RAG_API_TIMEOUT=150
# Gửi kèm câu gốc (extra_queries) bên cạnh câu Groq đã chuẩn hóa; RAG gộp kết quả bằng RRF.
# Tắt mặc định: đo 24/09 không thấy lợi (RAG-module/reports/2026-09-24-query-normalization).
RAG_SEARCH_ORIGINAL_QUERY=false
# Model trả lời người dùng chọn trên web (chỉ ANSWER_BACKEND=rag): vllm, gemini, ollama, cách nhau dấu phẩy.
# Model đầu là mặc định. Mỗi model phải cấu hình bên RAG-module/.env (Gemini cần GEMINI_API_KEY).
# Để trống = không hiện ô chọn, RAG dùng LLM_PROVIDER của nó.
CHAT_LLM_PROVIDERS=vllm,gemini
# Nút "Tìm trên web" ở trang chat: Groq tự tìm web (tool browser_search) và trả lời thẳng, không qua RAG.
# Groq chỉ có browser_search ở openai/gpt-oss-120b và openai/gpt-oss-20b. Để trống = ẩn nút.
WEB_SEARCH_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# MongoDB: phiên chat, feedback, Feedback RAG
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=plant_chatbot
# Số message gần nhất đưa vào LLM (normalizer + trả lời). 6 = như trước refactor.
MAX_HISTORY_TURNS=6

# ---------------------------------------------------------------------------
# Feedback RAG (QA admin duyệt): groq đưa vào prompt Groq; rag gửi sang RAG (feedback_examples).
# Lần đầu admin bấm "Đưa vào Feedback RAG" sẽ tải model embedding này về.
# ---------------------------------------------------------------------------
FEEDBACK_EMBEDDING_MODEL=intfloat/multilingual-e5-small
FEEDBACK_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
FEEDBACK_RETRIEVE_K=8
FEEDBACK_RERANK_K=2
FEEDBACK_SIMILARITY_THRESHOLD=0.55
FEEDBACK_RERANKER_ENABLED=true

# ---------------------------------------------------------------------------
# rag/ nội bộ (chỉ ANSWER_BACKEND=groq). Sửa xong chạy: python -m rag.ingest --reset
# ---------------------------------------------------------------------------
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------------
# Tách lá (GenYOLO)
# ---------------------------------------------------------------------------
# true = lưu ảnh sau khi tách lá vào debug/segmentation/
SAVE_SEGMENTATION_PREVIEW=false
YOLO_TOP_K=2
YOLO_MIN_MASK_AREA=100
# Ảnh gửi lên phải có lá cây, nếu không trả "Ảnh không hợp lệ" (HTTP 400).
# Hợp lệ khi có một lá với độ tin cậy >= LEAF_MIN_CONFIDENCE,
# hoặc lá (độ tin cậy >= 0.25) phủ >= LEAF_MIN_AREA_RATIO diện tích ảnh.
LEAF_MIN_CONFIDENCE=0.6
LEAF_MIN_AREA_RATIO=0.25

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Tài khoản trang quản trị: web (/admin/login của application/web) và trang /admin cũ (HTTP Basic).
# Web BẮT BUỘC có ADMIN_PASSWORD mới đăng nhập được. Để trống thì API /admin/* không được bảo vệ.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Phiên đăng nhập của web hết hạn sau số giờ này; đổi mật khẩu cũng làm mọi phiên cũ hết hiệu lực.
ADMIN_SESSION_HOURS=12
# Origin web/mobile được gọi API, cách nhau bằng dấu phẩy. Trống = không bật CORS.
# Ví dụ: http://localhost:3000,https://app.example.com
CORS_ORIGINS=
LOG_LEVEL=INFO
