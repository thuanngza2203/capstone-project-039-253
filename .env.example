# Biến cho docker-compose.yml. Chép thành .env (cùng thư mục) rồi sửa theo máy.
# Đây KHÔNG phải .env của từng module: RAG-module/.env, detection-server-module/.env cấu hình riêng.

# --- vLLM trên Vast.ai (bỏ trống nếu chỉ dùng Gemini hoặc Ollama) ---
# Mỗi lần thuê GPU, Vast cấp IP/cổng SSH mới: run.cmd hỏi lệnh SSH của Vast (nút Connect)
# rồi tự ghi hai dòng này, không cần sửa tay.
VAST_SSH_HOST=
VAST_SSH_PORT=
VAST_SSH_USER=root
# Cổng vLLM trên Vast (LLM_PORT bên LLM-server-module).
VAST_LLM_PORT=8000
# Private key SSH đã thêm vào tài khoản Vast, dùng dấu /. Ví dụ: C:/Users/<tên>/.ssh/vast_ed25519
VAST_SSH_KEY_FILE=

# --- Tùy chọn ---
# Dùng lại cache HuggingFace có sẵn trên máy để khỏi tải lại model (vài GB).
# Để trống thì Docker tự tải vào volume hf-cache ở lần chạy đầu.
# HF_CACHE_DIR=C:/Users/<tên>/.cache/huggingface

# Máy không có GPU NVIDIA: bỏ dấu # ở dòng dưới để RAG chạy embedding bằng CPU.
# COMPOSE_FILE=docker-compose.yml;docker-compose.cpu.yml

# MongoDB đang chạy trên Windows; host.docker.internal là địa chỉ của máy Windows nhìn từ container.
DOCKER_MONGO_URI=mongodb://host.docker.internal:27017

# Cổng mở ra trên máy.
WEB_PORT=5173
DETECTION_PORT=8005
RAG_PORT=8010
